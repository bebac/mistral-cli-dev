# -----------------------------------------------------------------------------
# embed_templates.cmake
#
# Build-time generator (CMake script mode). Embeds the workspace template
# files from templates/ into a C++ source file as raw string literals so the
# executable can bootstrap a .mistral-cli/ workspace without external files.
#
# Invoked from CMakeLists.txt via add_custom_command():
#   cmake -DOUT=<generated .cpp> -DTEMPLATES_DIR=<templates dir> -P embed_templates.cmake
#
# templates/ remains the single source of truth: editing a template file
# triggers regeneration and relink.
# -----------------------------------------------------------------------------

# Raw string literal delimiter. The generated file is only valid if none of
# the embedded files contain the closing sequence ")<delim>".
set(DELIM "mre")
set(NEEDLE ")${DELIM}\"")

get_filename_component(OUT_DIR "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${OUT_DIR}")

set(OUTPUT
"// Generated by cmake/embed_templates.cmake -- do not edit.
// Source of truth: templates/ in the repository root.

#include \"common/embedded_resources.h\"

namespace mistral::embedded
{

")

function(embed_file fn_name rel_path)
  file(READ "${TEMPLATES_DIR}/${rel_path}" CONTENT)
  string(FIND "${CONTENT}" "${NEEDLE}" needle_pos)
  if(needle_pos GREATER -1)
    message(FATAL_ERROR
      "embedded template '${rel_path}' contains the raw string delimiter '${NEEDLE}'")
  endif()
  string(APPEND OUTPUT
"std::string_view ${fn_name}()
{
  return R\"${DELIM}(${CONTENT})${DELIM}\";
}

")
  set(OUTPUT "${OUTPUT}" PARENT_SCOPE)
endfunction()

embed_file(sys_patchset_instructions "sys_patchset_instructions.md")
embed_file(sys_prompt "sys_prompt.md")
embed_file(sys_prompt_researcher "sys_prompt_researcher.md")
embed_file(sys_prompt_xerj "sys_prompt_xerj.md")
embed_file(sys_storybook_notes "sys_storybook_notes.md")
embed_file(policy_json "policy.json")
embed_file(config_json "mistral-cli.json")

string(APPEND OUTPUT "} // namespace mistral::embedded
")

file(WRITE "${OUT}" "${OUTPUT}")