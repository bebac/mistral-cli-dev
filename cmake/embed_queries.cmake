# -----------------------------------------------------------------------------
# embed_queries.cmake
#
# Build-time generator (CMake script mode). Embeds tree-sitter query files
# (.scm) from the grammar submodules into a C++ source file as raw string
# literals so the executable is fully standalone: queries are compiled in at
# build time and never read from disk at runtime.
#
# Invoked from CMakeLists.txt via add_custom_command():
#   cmake -DOUT=<generated .cpp> -DGRAMMARS_DIR=<grammars dir> -P embed_queries.cmake
#
# The grammar's queries/ directories remain the single source of truth: editing
# a query or bumping the grammar submodule triggers regeneration and relink.
# -----------------------------------------------------------------------------

set(DELIM "tsq")
set(NEEDLE ")${DELIM}\"")

get_filename_component(OUT_DIR "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${OUT_DIR}")

set(OUTPUT
"// Generated by cmake/embed_queries.cmake -- do not edit.
// Source of truth: queries/ directories of the grammar submodules.

#include \"common/embedded_resources.h\"

namespace mistral::embedded
{

")

function(embed_file fn_name base_dir rel_path)
  file(READ "${base_dir}/${rel_path}" CONTENT)
  string(FIND "${CONTENT}" "${NEEDLE}" needle_pos)
  if(needle_pos GREATER -1)
    message(FATAL_ERROR
      "embedded query '${rel_path}' contains the raw string delimiter '${NEEDLE}'")
  endif()
  string(APPEND OUTPUT
"std::string_view ${fn_name}()
{
  return R\"${DELIM}(${CONTENT})${DELIM}\";
}

")
  set(OUTPUT "${OUTPUT}" PARENT_SCOPE)
endfunction()

embed_file(cpp_tags_query "${GRAMMARS_DIR}" "tree-sitter-cpp/queries/tags.scm")
embed_file(cpp_references_query "${REPO_QUERIES_DIR}" "cpp-references.scm")

string(APPEND OUTPUT "} // namespace mistral::embedded
")

file(WRITE "${OUT}" "${OUTPUT}")