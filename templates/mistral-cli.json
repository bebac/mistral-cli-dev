{
  "models": {
    "mistral": {
      "provider": "mistral",
      "model_id": [
        "mistral-large-4",
        "deepseek-v4-1-flash-1017",
        "zai-glm-5-3-flash",
        "zai-glm-5-3",
        "mistral-small-latest"
      ],
      "api_key_env": "MISTRAL_API_KEY",
      "base_url": "https://api.mistral.ai",
      "api_version": "v1"
    },
    "greenpt": {
      "provider": "greenpt",
      "model_id": [
        "deepseek-v4.1-flash-1017",
        "glm-5.3-flash",
        "glm-5.3"
      ],
      "strict_mode": true,
      "api_key_env": "GREENPT_API_KEY",
      "base_url": "https://api.greenpt.ai",
      "api_version": "v1"
    }
  },
  "agents": {
    "main": {
      "model": "mistral",
      "system_prompt": "file://.mistral-cli/sys_prompt.md",
      "available_tools": [
        "ls",
        "exec",
        "process_start",
        "process_write",
        "process_read",
        "process_list",
        "process_kill",
        "read",
        "outline",
        "read_symbol",
        "find_symbol",
        "find_references",
        "ast_search",
        "patchset_get",
        "patchset_add",
        "patchset_clear",
        "patchset_validate",
        "patchset_update",
        "patchset_remove",
        "patchset_apply",
        "task_create",
        "task_list",
        "task_get",
        "task_update",
        "task_search",
        "web_search",
        "ask_user",
        "mcp:*"
      ],
      "subagent_tools": {
        "web_search": "researcher"
      },
      "tool_policy": "file://.mistral-cli/policy.json"
    },
    "researcher": {
      "model": "mistral",
      "model_id": "mistral-small-latest",
      "server_agent": {
        "name": "mistral-cli-researcher",
        "description": "Web research assistant for mistral-cli",
        "instructions": "file://.mistral-cli/sys_prompt_researcher.md",
        "tools": [
          { "type": "web_search" }
        ],
        "completion_args": {
          "temperature": 0.2
        }
      }
    }
  },
  "mcpServers": {
    "probe": {
      "enabled": false,
      "command": "npx",
      "args": ["-y", "@probelabs/probe@latest", "mcp"],
      "auto_connect": true
    },
    "xerj": {
      "enabled": false,
      "command": "xerj",
      "args": ["mcp"],
      "env": {
        "XERJ_URL": "http://localhost:9200"
      },
      "preflight": {
        "check_url": "http://localhost:9200",
        "start_command": ["xerj", "--insecure", "--data-dir", "~/xerj-data"],
        "post_start_command": ["xerj", "autoindex", "."]
      }
    },
    "storybook": {
      "enabled": false,
      "url": "http://127.0.0.1:6006/mcp"
    },
    "compiler-explorer": {
      "enabled": false,
      "url": "https://godbolt.org/mcp"
    }
  },
  "code_index": {
    "exclude_dirs": [
      ".git", ".mistral-cli", ".cache", ".vscode", ".vibe",
      "build", "node_modules", "__pycache__"
    ],
    "max_results": 200
  },
  "policy": {
    "default": "deny"
  }
}