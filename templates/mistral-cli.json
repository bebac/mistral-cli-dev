{
  "models": {
    "mistral-large": {
      "provider": "mistral",
      "model_id": "mistral-large-4",
      "api_key_env": "MISTRAL_API_KEY",
      "base_url": "https://api.mistral.ai",
      "api_version": "v1"
    },
    "mistral-medium": {
      "provider": "mistral",
      "model_id": "mistral-medium-latest",
      "api_key_env": "MISTRAL_API_KEY",
      "base_url": "https://api.mistral.ai",
      "api_version": "v1"
    },
    "mistral-small": {
      "provider": "mistral",
      "model_id": "mistral-small-latest",
      "api_key_env": "MISTRAL_API_KEY",
      "base_url": "https://api.mistral.ai",
      "api_version": "v1"
    }
  },
  "agents": {
    "main": {
      "model": "mistral-large",
      "system_prompt": "file://.mistral-cli/sys_prompt.md",
      "available_tools": [
        "ls",
        "exec",
        "process_start",
        "process_write",
        "process_read",
        "process_list",
        "process_kill",
        "read",
        "outline",
        "read_symbol",
        "find_symbol",
        "find_references",
        "ast_search",
        "search_docs",
        "search_code",
        "refresh_docs",
        "patchset_get",
        "patchset_add",
        "patchset_clear",
        "patchset_validate",
        "patchset_update",
        "patchset_remove",
        "patchset_apply",
        "task_create",
        "task_list",
        "task_get",
        "task_update",
        "task_search",
        "web_search",
        "ask_user",
        "mcp:*"
      ],
      "subagent_tools": {
        "web_search": "researcher"
      },
      "tool_policy": "file://.mistral-cli/policy.json"
    },
    "researcher": {
      "model": "mistral-small",
      "server_agent": {
        "name": "mistral-cli-researcher",
        "description": "Web research assistant for mistral-cli",
        "instructions": "file://.mistral-cli/sys_prompt_researcher.md",
        "tools": [
          { "type": "web_search" }
        ],
        "completion_args": {
          "temperature": 0.2
        }
      }
    }
  },
  "mcpServers": {
    "storybook": {
      "url": "http://127.0.0.1:6006/mcp"
    },
    "xerj": {
      "command": "xerj",
      "args": ["mcp"],
      "env": {
        "XERJ_URL": "http://localhost:9200"
      },
      "preflight": {
        "check_url": "http://localhost:9200",
        "start_command": ["xerj", "--insecure", "--data-dir", "~/xerj-data"],
        "post_start_command": ["xerj", "autoindex", "."]
      }
    }
  },
  "code_index": {
    "exclude_dirs": [
      ".git", ".mistral-cli", ".cache", ".vscode", ".vibe",
      "build", "node_modules", "__pycache__"
    ],
    "max_results": 200
  },
  "knowledge": {
    "enabled": true,
    "db_path": ".mistral-cli/cache/knowledge.db",
    "include_extensions": [".md", ".txt"],
    "exclude_dirs": [
      ".git", ".mistral-cli", ".cache", ".vscode", ".vibe",
      "build", "node_modules", "__pycache__"
    ],
    "chunk_max_chars": 1500,
    "embedding_dim": 384,
    "search_max_results": 10
  },
  "policy": {
    "default": "deny"
  }
}