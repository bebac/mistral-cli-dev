{
  "default": "require_approval",
  "allow": [
    { "type": "directory", "tool": "read", "path": "." },
    { "type": "tool", "tool": "ls" },
    { "type": "tool", "tool": "outline" },
    { "type": "tool", "tool": "read_symbol" },
    { "type": "tool", "tool": "find_symbol" },
    { "type": "tool", "tool": "find_references" },
    { "type": "tool", "tool": "ast_search" },
    { "type": "tool", "tool": "mcp:storybook" },
    { "type": "tool", "tool": "mcp:xerj" },
    { "type": "tool", "tool": "mcp:probe" },
    { "type": "tool", "tool": "task_list" },
    { "type": "tool", "tool": "task_get" },
    { "type": "tool", "tool": "task_update" },
    { "type": "tool", "tool": "task_search" },
    { "type": "tool", "tool": "patchset_get" },
    { "type": "tool", "tool": "patchset_add" },
    { "type": "tool", "tool": "patchset_remove" },
    { "type": "tool", "tool": "patchset_clear" },
    { "type": "tool", "tool": "patchset_validate" },
    { "type": "tool", "tool": "patchset_update" },
    { "type": "directory", "tool": "patchset_apply", "path": "." },
    { "type": "tool", "tool": "web_search" },
    { "type": "tool", "tool": "ask_user" },
    { "type": "tool", "tool": "process_write"},
    { "type": "tool", "tool": "process_read"},
    { "type": "tool", "tool": "process_list"},
    { "type": "tool", "tool": "process_kill"},
    { "type": "executable", "tool": "exec", "command": "date", "forbid_args": ["-f", "--file"] },
    { "type": "executable", "tool": "exec", "command": "tail", "cwd": [".", "/tmp"], "path_operands": "all" },
    { "type": "executable", "tool": "exec", "command": "head", "cwd": [".", "/tmp"], "path_operands": "all" },
    { "type": "executable", "tool": "exec", "command": "cat", "cwd": [".", "/tmp"], "path_operands": "all" },
    { "type": "executable", "tool": "exec", "command": "wc", "cwd": [".", "/tmp"], "path_operands": "all" },
    { "type": "executable", "tool": "exec", "command": "grep", "cwd": [".", "/tmp"], "path_operands": "all" },
    { "type": "executable", "tool": "exec", "command": "git", "cwd": ".",
      "subcommand": ["status", "diff", "log", "ls-files", "check-ignore"],
      "value_args": ["-C", "--git-dir", "--work-tree", "--namespace"],
      "path_args": ["-C", "--git-dir", "--work-tree"],
      "forbid_args": ["-c", "--exec-path**", "--ext-diff", "--textconv", "--output**"] },
    { "type": "executable", "tool": "exec", "command": "find", "cwd": ".",
      "path_operands": "leading",
      "forbid_args": ["-exec", "-execdir", "-ok", "-okdir", "-delete", "-fprint*", "-fls"] },
    { "type": "executable", "tool": "exec", "command": "ls", "cwd": [".", "/tmp"], "path_operands": "all" },
    { "type": "executable", "tool": "exec", "command": "tests", "cwd": "build" },
    { "type": "executable", "tool": "exec", "command": "make", "cwd": ".",
      "path_args": ["-f", "--file", "-C", "--directory"] },
    { "type": "executable", "tool": "exec", "command": "cmake", "cwd": ".",
      "path_args": ["--build", "-S", "-B", "-C", "--toolchain", "--install-prefix",
                     "--graphviz", "--trace-redirect", "--profiling-output"],
      "forbid_args": ["-E**", "-P**", "--install", "--open"] },
    { "type": "executable", "tool": "exec", "command": "ctest", "cwd": ".",
      "path_args": ["--test-dir", "-O", "--output-log", "--output-junit",
                    "--resource-spec-file", "--tests-from-file", "--exclude-from-file"],
      "forbid_args": ["-S**", "--script**", "-D**", "--dashboard**",
                      "-M**", "--test-model**", "-T**", "--test-action**",
                      "--build-and-test", "--test-command**"] },
    { "type": "executable", "tool": "exec", "command": "rm", "cwd": ".",
      "path_operands": "all" }
  ]
}
